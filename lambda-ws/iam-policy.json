{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:eu-west-3:637423486388:*"
    },
    {
      "Sid": "CloudWatchLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-3:637423486388:log-group:/aws/lambda/*:*"
    },
    {
      "Sid": "PostToConnection",
      "Effect": "Allow",
      "Action": "execute-api:ManageConnections",
      "Resource": "arn:aws:execute-api:eu-west-3:637423486388:REPLACE_WS_API_ID/*/POST/@connections/*"
    },
    {
      "Sid": "ConnectionsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Connections"
    },
    {
      "Sid": "ConnectionsLobbyIndex",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Connections/index/lobby-index"
    },
    {
      "Sid": "GameStateTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/GameState"
    },
    {
      "Sid": "QuestionsRead",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Questions"
    },
    {
      "Sid": "PhaseTimerStateMachine",
      "Effect": "Allow",
      "Action": [
        "states:StartExecution",
        "states:StopExecution"
      ],
      "Resource": [
        "arn:aws:states:eu-west-3:637423486388:stateMachine:ipakSeOkrecePhaseTimer",
        "arn:aws:states:eu-west-3:637423486388:execution:ipakSeOkrecePhaseTimer:*"
      ]
    },
    {
      "Sid": "LobbiesTableReadCloseAndKick",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:DeleteItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Lobbies"
    },
    {
      "Sid": "LobbiesCodeIndex",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Lobbies/index/code-index"
    },
    {
      "Sid": "PlayersProfileReadAndResultWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Players"
    },
    {
      "Sid": "MatchesArchiveWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/Matches"
    },
    {
      "Sid": "ChatMessagesWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:637423486388:table/ChatMessages"
    }
  ]
}
